classDiagram
    namespace ContentModel {
        class ContentItem {
            <<abstract>>
            +id: string
            +title: string
            +author: string
            +price: string
            +preview()* string
        }
        class Article {
            <<abstract>>
            +category: ArticleCategory
            +body: string
        }
        class WorldNewsArticle {
            +region: string
            +preview() string
        }
        class BusinessArticle {
            +relatedCompany: string
            +preview() string
        }
        class LifestyleArticle {
            +subtype: LifestyleSubtype
            +highlights: string[]
            +preview() string
        }
    }

    namespace PaymentAndServices {
        class PaymentProvider {
            <<interface>>
            +getPaymentRequirements(article, resourceUrl) Promise~PaymentRequirements~
            +verifyPayment(paymentHeader, requirements) Promise~VerificationResult~
            +settlePayment(paymentHeader, requirements) Promise~SettlementResult~
        }
        class ContentRepository {
            <<interface>>
            +getById(id) Promise~ContentItem~
            +getAll(filters) Promise~ContentItem[]~
            +save(item) Promise~void~
        }
        class PaymentVerifier {
            -config: PaymentVerifierConfig
            +getPaymentRequirements(article, resourceUrl) Promise~PaymentRequirements~
            +verifyPayment(paymentHeader, requirements) Promise~VerificationResult~
            +settlePayment(paymentHeader, requirements) Promise~SettlementResult~
            -checkBinding(payload, requirements) string
        }
        class ArticleRepository {
            -items: Map
            +getById(id) Promise~ContentItem~
            +getAll(filters) Promise~ContentItem[]~
            +save(item) Promise~void~
        }
        class TransactionLogger {
            -transactions: Transaction[]
            +record(transaction) Promise~void~
            +getAll() Promise~Transaction[]~
            +hasPurchased(walletAddress, articleId) Promise~boolean~
        }
        class SalesReportGenerator {
            -logger: TransactionStore
            -articles: ContentRepository
            +generate() Promise~SalesReport~
        }
        class Transaction {
            +articleId: string
            +author: string
            +buyerWalletAddress: string
            +amount: string
            +timestamp: string
            +settlementStatus: string
            +transactionHash: string
        }
        class SalesReport {
            +generatedAt: string
            +byArticle: SalesSummary[]
            +byCategory: SalesSummary[]
            +byAuthor: SalesSummary[]
        }
        class TransactionStore {
            <<interface>>
            +record(transaction) Promise~void~
            +getAll() Promise~Transaction[]~
            +hasPurchased(walletAddress, articleId) Promise~boolean~
        }
    }

    ContentItem <|-- Article
    Article <|-- WorldNewsArticle
    Article <|-- BusinessArticle
    Article <|-- LifestyleArticle

    PaymentProvider <|.. PaymentVerifier
    ContentRepository <|.. ArticleRepository

    ArticleRepository ..> ContentItem : stores
    TransactionStore <|.. TransactionLogger
    SalesReportGenerator --> TransactionStore
    SalesReportGenerator --> ContentRepository
    SalesReportGenerator ..> SalesReport
    TransactionLogger --> Transaction